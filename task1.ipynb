import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# 1. Load the dataset
# Replace 'online_retail.csv' with the actual path to your file
df = pd.read_csv('online_retail.csv', encoding='ISO-8859-1')

# 2. Data Cleaning
# Remove rows with missing CustomerID for cleaner customer analysis
df = df.dropna(subset=['CustomerID'])

# Remove cancellations (Invoice numbers starting with 'C')
df = df[~df['InvoiceNo'].str.contains('C', na=False)]

# Ensure Quantity and UnitPrice are positive
df = df[(df['Quantity'] > 0) & (df['UnitPrice'] > 0)]

# Convert InvoiceDate to datetime
df['InvoiceDate'] = pd.to_datetime(df['InvoiceDate'])

# 3. Feature Engineering
# Calculate Total Sales (Revenue)
df['TotalRevenue'] = df['Quantity'] * df['UnitPrice']

# Extract Month and Year for trend analysis
df['MonthYear'] = df['InvoiceDate'].dt.to_period('M')

# 4. Analysis: Top 10 Products by Revenue
top_products = df.groupby('Description')['TotalRevenue'].sum().sort_values(ascending=False).head(10)

# 5. Analysis: Revenue Trend over Time
monthly_revenue = df.groupby('MonthYear')['TotalRevenue'].sum()

# 6. Analysis: Top Countries by Revenue (Excluding UK for better scale)
country_revenue = df[df['Country'] != 'United Kingdom'].groupby('Country')['TotalRevenue'].sum().sort_values(ascending=False).head(10)

# --- VISUALIZATION ---

plt.figure(figsize=(14, 10))

# Plot 1: Monthly Revenue Trend
plt.subplot(2, 1, 1)
monthly_revenue.plot(kind='line', marker='o', color='b', linewidth=2)
plt.title('Monthly Revenue Trend (2010-2011)', fontsize=14)
plt.ylabel('Revenue')
plt.grid(True)

# Plot 2: Top 10 Products
plt.subplot(2, 2, 3)
top_products.plot(kind='bar', color='teal')
plt.title('Top 10 Products by Revenue', fontsize=12)
plt.ylabel('Total Revenue')
plt.xticks(rotation=45, ha='right')

# Plot 3: Top International Markets
plt.subplot(2, 2, 4)
country_revenue.plot(kind='bar', color='orange')
plt.title('Top 10 International Markets (Excl. UK)', fontsize=12)
plt.ylabel('Total Revenue')

plt.tight_layout()
plt.show()

# --- INSIGHTS SUMMARY ---
print("--- Business Analytics Summary ---")
print(f"Total Revenue Generated: ${df['TotalRevenue'].sum():,.2f}")
print(f"Total Unique Customers: {df['CustomerID'].nunique()}")
print(f"Average Order Value: ${df.groupby('InvoiceNo')['TotalRevenue'].sum().mean():,.2f}")
